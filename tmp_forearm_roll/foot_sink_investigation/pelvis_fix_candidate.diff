+def _reference_sole_height(arm, roles, space):
+    """Lowest rest/bind foot-region skin point in motion space, or None.
+
+    Uses the same bind skin points as the contact recheck so the pelvis
+    ground datum matches the sole the recheck grounds to. Returns None
+    when the rig has no usable foot skin; the caller then keeps the
+    legacy zero-ground pelvis mapping for both rigs.
+    """
+    names = []
+    for chain in _IK_CHAIN_ROLES[:2]:
+        if not all(role in roles for role in chain):
+            continue
+        _upper, mid, end = (roles[role] for role in chain)
+        names.extend((mid, end))
+        names.extend(child.name for child in arm.data.bones[end].children)
+    if not names:
+        return None
+    points = _extract_foot_skin_points(arm, tuple(names))
+    if not points:
+        return None
+    lowest = None
+    for bind_point, _influences in points:
+        z = space.world_position(arm.matrix_world @ bind_point).z
+        lowest = z if lowest is None else min(lowest, z)
+    return lowest
+
+
